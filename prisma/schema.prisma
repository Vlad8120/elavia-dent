generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  phone     String?
  city      String?
  role      Role     @default(BUYER)
  blocked   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products                Product[]
  favorites               Favorite[]
  reviews                 Review[]
  sentMessages            Message[]        @relation("SentMessages")
  receivedMessages        Message[]        @relation("ReceivedMessages")
  sentServiceMessages     ServiceMessage[] @relation("SentServiceMessages")
  receivedServiceMessages ServiceMessage[] @relation("ReceivedServiceMessages")
}

enum Role {
  BUYER
  SELLER
  CLINIC_OWNER
  ADMIN
}

model Category {
  id       Int       @id @default(autoincrement())
  name     String    @unique
  icon     String
  slug     String    @unique
  products Product[]
}

model Product {
  id          Int       @id @default(autoincrement())
  title       String
  description String
  price       Float
  city        String
  oblast      String
  condition   Condition @default(NEW)
  image       String?
  views       Int       @default(0)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  categoryId  Int
  category    Category  @relation(fields: [categoryId], references: [id])
  sellerId    Int
  seller      User      @relation(fields: [sellerId], references: [id])

  favorites    Favorite[]
  messages     Message[]
  priceHistory PriceHistory[]
}

enum Condition {
  NEW
  USED
}

model Clinic {
  id          Int      @id @default(autoincrement())
  name        String
  description String
  city        String
  oblast      String
  address     String
  phone       String
  email       String
  image       String?
  rating      Float    @default(0)
  founded     Int?
  doctors     Int      @default(1)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  services    ClinicService[]
  reviews     Review[]
  favorites   Favorite[]
  messages    Message[]
}

model Service {
  id          Int     @id @default(autoincrement())
  name        String
  description String
  priceFrom   Float
  priceTo     Float
  duration    String

  clinics         ClinicService[]
  serviceMessages ServiceMessage[]
}

model ClinicService {
  id        Int     @id @default(autoincrement())
  clinicId  Int
  serviceId Int
  clinic    Clinic  @relation(fields: [clinicId], references: [id])
  service   Service @relation(fields: [serviceId], references: [id])
}

model Favorite {
  id        Int      @id @default(autoincrement())
  userId    Int
  productId Int?
  clinicId  Int?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
  product   Product? @relation(fields: [productId], references: [id])
  clinic    Clinic?  @relation(fields: [clinicId], references: [id])
}

model Review {
  id        Int      @id @default(autoincrement())
  text      String
  rating    Int
  createdAt DateTime @default(now())
  userId    Int
  clinicId  Int
  user      User     @relation(fields: [userId], references: [id])
  clinic    Clinic   @relation(fields: [clinicId], references: [id])
}

model Message {
  id         Int      @id @default(autoincrement())
  text       String
  createdAt  DateTime @default(now())
  senderId   Int
  receiverId Int
  productId  Int?
  clinicId   Int?
  isRead     Boolean  @default(false)

  sender     User     @relation("SentMessages", fields: [senderId], references: [id])
  receiver   User     @relation("ReceivedMessages", fields: [receiverId], references: [id])
  product    Product? @relation(fields: [productId], references: [id])
  clinic     Clinic?  @relation(fields: [clinicId], references: [id])
}

model ServiceMessage {
  id         Int      @id @default(autoincrement())
  text       String
  createdAt  DateTime @default(now())
  senderId   Int
  receiverId Int
  serviceId  Int
  isRead     Boolean  @default(false)

  sender     User     @relation("SentServiceMessages", fields: [senderId], references: [id])
  receiver   User     @relation("ReceivedServiceMessages", fields: [receiverId], references: [id])
  service    Service  @relation(fields: [serviceId], references: [id])
}

model PriceHistory {
  id        Int      @id @default(autoincrement())
  price     Float
  createdAt DateTime @default(now())
  productId Int
  product   Product  @relation(fields: [productId], references: [id])
}